{
  "name": "vsc-Eezzy",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#050706",
    "editor.lineHighlightBackground": "#0D120F",
    "editor.selectionBackground": "#17251D",
    "editorSuggestWidget.background": "#0A0F0C",
    "editorLineNumber.foreground": "#343D4B",
    "editorLineNumber.activeForeground": "#A7B0BE",
    "editor.foreground": "#DDE5EE",
    "editorCursor.foreground": "#F8FAFC",
    "editorWhitespace.foreground": "#343D4B",
    "editorIndentGuide.background": "#343D4B",
    "editorIndentGuide.activeBackground": "#A7B0BE",
    "editorBracketMatch.border": "#1B2A22",
    "editorBracketMatch.background": "#1B2A22",
    "sideBar.background": "#0A0F0C",
    "sideBar.foreground": "#8792A2",
    "activityBar.background": "#0A0F0C",
    "activityBar.foreground": "#8792A2",
    "activityBarBadge.background": "#111A15",
    "badge.background": "#111A15",
    "badge.foreground": "#F8FAFC",
    "button.background": "#111A15",
    "editor.lineHighlightBorder": "#1B2A22",
    "editorGroupHeader.tabsBackground": "#0A0F0C",
    "editorGroupHeader.tabsBorder": "#0A0F0C",
    "focusBorder": "#1B2A22",
    "foreground": "#DDE5EE",
    "input.background": "#0A0F0C",
    "input.foreground": "#DDE5EE",
    "list.activeSelectionBackground": "#17251D",
    "list.activeSelectionForeground": "#F8FAFC",
    "list.focusBackground": "#17251D",
    "list.highlightForeground": "#DDE5EE",
    "list.hoverBackground": "#17251D",
    "list.hoverForeground": "#DDE5EE",
    "list.inactiveSelectionBackground": "#17251D",
    "list.inactiveSelectionForeground": "#F8FAFC",
    "panelTitle.activeBorder": "#0A0F0C",
    "panelTitle.activeForeground": "#DDE5EE",
    "panelTitle.inactiveForeground": "#8792A2",
    "peekView.border": "#1B2A22",
    "peekViewEditor.background": "#0A0F0C",
    "pickerGroup.border": "#1B2A22",
    "pickerGroup.foreground": "#DDE5EE",
    "progressBar.background": "#F8FAFC",
    "scrollbar.shadow": "#0A0F0C",
    "sideBarSectionHeader.background": "#0A0F0C",
    "statusBar.background": "#0A0F0C",
    "statusBar.debuggingBackground": "#0A0F0C",
    "statusBar.foreground": "#8792A2",
    "statusBar.noFolderBackground": "#0A0F0C",
    "statusBarItem.remoteForeground": "#8792A2",
    "statusBarItem.remoteBackground": "#0A0F0C",
    "statusBarItem.prominentBackground": "#111A15",
    "tab.activeBorder": "#0A0F0C",
    "tab.activeForeground": "#F8FAFC",
    "tab.border": "#0A0F0C",
    "tab.inactiveBackground": "#0A0F0C",
    "tab.inactiveForeground": "#8792A2",
    "textLink.foreground": "#80BFFF",
    "textLink.activeForeground": "#F8FAFC",
    "titleBar.activeBackground": "#0A0F0C",
    "titleBar.border": "#00000000",
    "terminal.ansiBlack": "#000000",
    "terminal.ansiBrightBlack": "#7A8494",
    "terminal.ansiRed": "#FF6B6B",
    "terminal.ansiBrightRed": "#FF6B6B",
    "terminal.ansiGreen": "#74D66A",
    "terminal.ansiBrightGreen": "#74D66A",
    "terminal.ansiYellow": "#FFD166",
    "terminal.ansiBrightYellow": "#FFD166",
    "terminal.ansiBlue": "#7EA6FF",
    "terminal.ansiBrightBlue": "#7EA6FF",
    "terminal.ansiMagenta": "#C792EA",
    "terminal.ansiBrightMagenta": "#C792EA",
    "terminal.ansiCyan": "#4DD6C3",
    "terminal.ansiBrightCyan": "#4DD6C3",
    "terminal.ansiWhite": "#DDE5EE",
    "terminal.ansiBrightWhite": "#F8FAFC",
    "inputOption.activeBackground": "#111A15",
    "debugIcon.continueForeground": "#FF6B6B",
    "debugIcon.disconnectForeground": "#FF6B6B",
    "debugIcon.pauseForeground": "#FF6B6B",
    "debugIcon.restartForeground": "#74D66A",
    "debugIcon.startForeground": "#74D66A",
    "debugIcon.stepBackForeground": "#FF6B6B",
    "debugIcon.stepIntoForeground": "#FF6B6B",
    "debugIcon.stepOutForeground": "#FF6B6B",
    "debugIcon.stepOverForeground": "#FF6B6B",
    "debugIcon.stopForeground": "#74D66A",
    "debugIcon.breakpointCurrentStackframeForeground": "#74D66A",
    "debugIcon.breakpointDisabledForeground": "#8792A2",
    "debugIcon.breakpointForeground": "#FF6B6B",
    "debugIcon.breakpointStackframeForeground": "#74D66A",
    "debugIcon.breakpointUnverifiedForeground": "#8792A2",
    "diffEditor.insertedTextBackground": "#74D66A22",
    "diffEditor.removedTextBackground": "#FF6B6B22"
  },
  "tokenColors": [
    {
      "scope": ["comment", "string.quoted.docstring.multi"],
      "settings": {
        "foreground": "#6F7A89",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#7EA6FF"
      }
    },
    {
      "scope": ["keyword", "storage", "storage.type"],
      "settings": {
        "foreground": "#FF5C8A"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#4DD6C3"
      }
    },
    {
      "scope": ["variable.other.property", "meta.property-name"],
      "settings": {
        "foreground": "#7CF9B8"
      }
    },
    {
      "scope": ["string", "markup.inline"],
      "settings": {
        "foreground": "#A6D88A"
      }
    },
    {
      "scope": ["constant.numeric", "number"],
      "settings": {
        "foreground": "#C792EA"
      }
    },
    {
      "scope": [
        "storage.type",
        "entity.name.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#FFB86C"
      }
    },
    {
      "scope": ["entity.name.class"],
      "settings": {
        "foreground": "#D2FF72"
      }
    },
    {
      "scope": "markup.error",
      "settings": {
        "foreground": "#FF6B6B"
      }
    },
    {
      "scope": "markup.warning",
      "settings": {
        "foreground": "#FFD166"
      }
    },
    {
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#74D66A"
      }
    },
    {
      "name": "JSX/TSX Components",
      "scope": [
        "support.class.component.jsx",
        "support.class.component.tsx",
        "entity.name.tag.jsx",
        "entity.name.tag.tsx"
      ],
      "settings": {
        "foreground": "#D2FF72"
      }
    },
    {
      "name": "JSX/TSX HTML Tags",
      "scope": [
        "entity.name.tag.html.jsx",
        "entity.name.tag.html.tsx",
        "punctuation.definition.tag.jsx",
        "punctuation.definition.tag.tsx"
      ],
      "settings": {
        "foreground": "#FFB86C"
      }
    },
    {
      "name": "JSX/TSX Attributes",
      "scope": [
        "entity.other.attribute-name.jsx",
        "entity.other.attribute-name.tsx"
      ],
      "settings": {
        "foreground": "#7CF9B8"
      }
    },
    {
      "name": "JSX/TSX Brackets",
      "scope": [
        "punctuation.section.embedded.begin.jsx",
        "punctuation.section.embedded.end.jsx",
        "punctuation.section.embedded.begin.tsx",
        "punctuation.section.embedded.end.tsx"
      ],
      "settings": {
        "foreground": "#F8FAFC"
      }
    },
    {
      "name": "TypeScript Types",
      "scope": [
        "entity.name.type.ts",
        "entity.name.type.tsx",
        "support.type.primitive.ts",
        "support.type.primitive.tsx"
      ],
      "settings": {
        "foreground": "#FFB86C"
      }
    },
    {
      "name": "TypeScript Interfaces",
      "scope": [
        "entity.name.type.interface.ts",
        "entity.name.type.interface.tsx"
      ],
      "settings": {
        "foreground": "#4DD6C3"
      }
    },
    {
      "name": "TypeScript Generics",
      "scope": [
        "punctuation.definition.typeparameters.begin.ts",
        "punctuation.definition.typeparameters.end.ts",
        "punctuation.definition.typeparameters.begin.tsx",
        "punctuation.definition.typeparameters.end.tsx"
      ],
      "settings": {
        "foreground": "#C792EA"
      }
    },
    {
      "name": "Template Literals",
      "scope": [
        "string.template",
        "punctuation.definition.string.template.begin",
        "punctuation.definition.string.template.end"
      ],
      "settings": {
        "foreground": "#A6D88A"
      }
    },
    {
      "name": "Template Literal Expressions",
      "scope": [
        "meta.template.expression",
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end"
      ],
      "settings": {
        "foreground": "#F8FAFC"
      }
    },
    {
      "name": "Arrow Functions",
      "scope": ["storage.type.function.arrow"],
      "settings": {
        "foreground": "#FF5C8A"
      }
    },
    {
      "name": "Import/Export Keywords",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.as"
      ],
      "settings": {
        "foreground": "#FF5C8A"
      }
    },
    {
      "name": "Import/Export Modules",
      "scope": ["variable.other.readwrite.alias", "meta.import string.quoted"],
      "settings": {
        "foreground": "#A6D88A"
      }
    },
    {
      "name": "Object Methods",
      "scope": [
        "meta.method.declaration entity.name.function",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#4DD6C3"
      }
    },
    {
      "name": "Destructuring",
      "scope": [
        "meta.object-binding-pattern-variable variable.other.readwrite",
        "meta.array-binding-pattern-variable variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#7CF9B8"
      }
    },
    {
      "name": "Spread Operator",
      "scope": ["keyword.operator.spread"],
      "settings": {
        "foreground": "#FF5C8A"
      }
    },
    {
      "name": "React Hooks",
      "scope": ["meta.function-call entity.name.function"],
      "settings": {
        "foreground": "#4DD6C3"
      }
    },
    {
      "name": "TypeScript Decorators",
      "scope": ["punctuation.decorator", "meta.decorator"],
      "settings": {
        "foreground": "#C792EA"
      }
    },
    {
      "name": "CSS in JS",
      "scope": ["source.css.styled", "meta.template.expression.css"],
      "settings": {
        "foreground": "#A6D88A"
      }
    }
  ]
}
